{
  "name": "revscope",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-labelled binary analysis for the command line and MCP clients, using Ghidra headless as the analysis engine.",
  "license": "Apache-2.0",
  "author": "Sambit Biswas",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sambit1110/revscope.git"
  },
  "homepage": "https://github.com/Sambit1110/revscope#readme",
  "bugs": {
    "url": "https://github.com/Sambit1110/revscope/issues"
  },
  "keywords": [
    "reverse-engineering",
    "binary-analysis",
    "ghidra",
    "decompiler",
    "mcp",
    "model-context-protocol",
    "cli",
    "evidence",
    "static-analysis"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "bin": {
    "revscope": "dist/bin/revscope.js"
  },
  "files": [
    "dist/",
    "ghidra-scripts/",
    "docs/",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src tests benchmarks scripts",
    "test": "npm run build && vitest run",
    "test:ghidra": "npm run build && vitest run --config vitest.ghidra.config.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "benchmark": "npm run build && node benchmarks/run.ts",
    "licenses": "node scripts/check-licenses.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.1",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
